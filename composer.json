{
    "name": "contao/setup-and-testing",
    "description": "Development package for the Contao setup and testing packages",
    "license": "LGPL-3.0-or-later",
    "type": "project",
    "require": {
        "ext-zip": "*",
        "php": "^8.2",
        "doctrine/dbal": "^3.6 || ^4.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.0 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/panther": "^2.1",
        "symfony/process": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Contao\\E2eTestBundle\\Tests\\": "e2e-test-bundle/tests/",
            "Contao\\InstallationRecipe\\Tests\\": "installation-recipe/tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "contao-manager-plugin": []
    },
    "scripts": {
        "all": [
            "@rector",
            "@ecs",
            "@test",
            "@phpstan",
            "@monorepo-tools"
        ],
        "ecs": "@php vendor-bin/ecs/vendor/bin/ecs check --fix --no-progress-bar",
        "monorepo-tools": "@php vendor-bin/monorepo-tools/vendor/bin/monorepo-tools composer-json --validate",
        "phpstan": "@php vendor-bin/phpstan/vendor/bin/phpstan analyse --configuration=phpstan.neon --no-progress",
        "rector": "@php vendor-bin/rector/vendor/bin/rector --no-progress-bar",
        "test": "@php vendor/bin/phpunit --configuration=phpunit.xml.dist"
    },
    "replace": {
        "contao/e2e-test-bundle": "self.version",
        "contao/installation-recipe": "self.version"
    },
    "bin": [
        "e2e-test-bundle/bin/contao-e2e"
    ],
    "autoload": {
        "psr-4": {
            "Contao\\E2eTestBundle\\": "e2e-test-bundle/src/",
            "Contao\\InstallationRecipe\\": "installation-recipe/src/"
        }
    }
}
