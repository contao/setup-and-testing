{
    "name": "contao/e2e-test-bundle",
    "description": "End-to-end testing support for isolated Contao Managed Editions",
    "license": "LGPL-3.0-or-later",
    "type": "library",
    "require": {
        "php": "^8.2",
        "contao/installation-recipe": "self.version",
        "doctrine/dbal": "^3.6 || ^4.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0",
        "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
        "symfony/console": "^6.4 || ^7.0 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.0 || ^8.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
        "symfony/panther": "^2.1",
        "symfony/process": "^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Contao\\E2eTestBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contao\\E2eTestBundle\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/contao-e2e"
    ],
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
