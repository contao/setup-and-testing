{
    "name": "contao/installation-recipe",
    "description": "Describes and applies reusable Contao installation recipes",
    "license": "LGPL-3.0-or-later",
    "type": "library",
    "require": {
        "ext-zip": "*",
        "php": "^8.2",
        "doctrine/dbal": "^3.6 || ^4.0",
        "symfony/filesystem": "^6.4 || ^7.0 || ^8.0",
        "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Contao\\InstallationRecipe\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contao\\InstallationRecipe\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    }
}
